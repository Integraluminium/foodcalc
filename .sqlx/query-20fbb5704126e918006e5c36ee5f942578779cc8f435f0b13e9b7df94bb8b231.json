  "query": "\n            SELECT ugr.user_id, g.id, g.name, g.is_personal, ugr.role_slug\n            FROM user_group_roles ugr\n            JOIN groups g ON g.id = ugr.group_id\n            ORDER BY ugr.user_id, g.is_personal DESC, g.name, ugr.role_slug\n            ",
