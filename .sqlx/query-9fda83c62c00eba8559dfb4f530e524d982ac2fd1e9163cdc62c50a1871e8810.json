{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT fp.prep_id as \"id\", fp.event_id, fp.recipe_id, fp.prep_date,\n                fp.use_from, fp.use_until,\n                r.name AS \"recipe_name!\"\n            FROM food_prep fp\n            JOIN recipes r ON r.recipe_id = fp.recipe_id\n            WHERE fp.event_id = $1\n            ORDER BY fp.prep_date, fp.use_until\n            ",
