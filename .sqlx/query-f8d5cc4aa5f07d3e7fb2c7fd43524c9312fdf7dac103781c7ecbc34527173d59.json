  "query": "\n            SELECT g.id, g.name, g.is_personal, ugr.role_slug\n            FROM user_group_roles ugr\n            JOIN groups g ON ugr.group_id = g.id\n            WHERE ugr.user_id = $1\n            ORDER BY g.is_personal DESC, g.name, ugr.role_slug\n            ",
