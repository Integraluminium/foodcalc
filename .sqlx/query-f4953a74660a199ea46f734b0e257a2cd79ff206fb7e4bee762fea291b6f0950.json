{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                r.recipe_id as id,\n                r.name,\n                r.comment,\n                r.group_id,\n                r.kind as \"kind: RecipeKind\",\n                r.weighed_in,\n                COALESCE(s.weight, 0) as \"weight!\",\n                COALESCE(s.energy, 0) as \"energy!\"\n            FROM recipes r\n            LEFT JOIN recipe_stats s ON s.recipe_id = r.recipe_id\n            ORDER BY r.name\n            ",
