  "query": "\n            SELECT DISTINCT g.id, g.name, g.is_personal\n            FROM user_group_roles ugr\n            JOIN groups g ON ugr.group_id = g.id\n            WHERE ugr.user_id = $1\n            ORDER BY g.is_personal DESC, g.name\n            ",
