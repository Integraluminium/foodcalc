{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT DISTINCT u.id, u.username, u.email, u.password_hash, u.is_admin, u.created_at\n            FROM event_user_roles eur\n            JOIN users u ON u.id = eur.user_id\n            WHERE eur.event_id = $1\n            ORDER BY u.username\n            ",
