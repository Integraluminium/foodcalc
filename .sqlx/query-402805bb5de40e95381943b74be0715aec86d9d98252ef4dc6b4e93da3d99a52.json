  "db_name": "PostgreSQL",
  "query": "\n            SELECT DISTINCT u.id, u.username, u.email, u.password_hash, u.is_admin, u.created_at\n            FROM user_group_roles ugr\n            JOIN users u ON u.id = ugr.user_id\n            WHERE ugr.group_id = $1\n            ORDER BY u.username\n            ",
