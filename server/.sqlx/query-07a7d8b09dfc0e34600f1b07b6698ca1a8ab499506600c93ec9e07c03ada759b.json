  "query": "\n            SELECT recipe_id as id, name, comment, group_id, weighed_in,\n                   kind as \"kind: RecipeKind\"\n            FROM recipes\n            WHERE group_id IN (\n                SELECT group_id FROM user_groups WHERE user_id = $1\n            )\n            ORDER BY name\n            ",
