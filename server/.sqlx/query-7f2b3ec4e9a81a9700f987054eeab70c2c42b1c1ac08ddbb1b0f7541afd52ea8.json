  "query": "\n            SELECT i.inventory_id as \"id\", i.name, i.group_id\n            FROM event_inventories ei\n            JOIN inventories i ON i.inventory_id = ei.inventory_id\n            WHERE ei.event_id = $1\n            ORDER BY i.name\n            ",
